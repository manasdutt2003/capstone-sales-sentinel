{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python src/main.py:*)",
      "Bash(python -m pytest:*)",
      "Bash(pytest:*)",
      "Bash(python tools/spec_coverage.py:*)",
      "Bash(python tools/mutation_smoke.py:*)",
      "Bash(python tools/hook_selftest.py:*)",
      "mcp__sales-dq__profile_csv",
      "mcp__sales-dq__run_pipeline",
      "mcp__sales-dq__explain_row",
      "mcp__sales-dq__quarantine_summary",
      "mcp__sales-dq__spec_rules",
      "mcp__sales-dq__spec_coverage_report"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(git push:*)"
    ]
  },
  "enabledMcpjsonServers": ["sales-dq"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_context.py\"", "timeout": 30 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_boundaries.py\"", "timeout": 15 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit_feedback.py\"", "timeout": 150 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent_gate.py\"", "timeout": 400 }
        ]
      }
    ]
  }
}
